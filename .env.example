# Copy to .env and adjust. Values already present in the real environment always
# win over this file, so the same file is safe to keep in a container image.
#
# Every timeout and TTL is a Go duration string ("15m", "500ms", "1h30m").
# A bare number is rejected and the default applies, so the unit is never implied.

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=go-boilerplate
APP_ENV=development                 # development | staging | production
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s         # grace period for draining on SIGTERM
LOG_LEVEL=debug                     # trace | debug | info | warn | error
LOG_FORMAT=text                     # json | text  (use json in production)
ALLOW_ORIGIN=*                      # comma-separated
# TRUSTED_PROXIES=10.0.0.0/8        # set when running behind a proxy

# ─── Security ─────────────────────────────────────────────────────────────────
# JWT_SECRET has no default: an unset signing key fails at boot rather than
# falling back to a well-known placeholder. Minimum 32 bytes.
JWT_SECRET=change-me-to-at-least-32-bytes-of-random
JWT_ISSUER=go-boilerplate
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
BCRYPT_COST=12

# ─── Postgres (always connected) ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app_secret
POSTGRES_DB=app
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=UTC
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=15m
POSTGRES_CONN_MAX_IDLE_TIME=5m
POSTGRES_CONNECT_TIMEOUT=10s
POSTGRES_LOG_LEVEL=warn             # silent | error | warn | info
POSTGRES_SLOW_THRESHOLD=500ms
POSTGRES_PREPARE_STMT=true          # set false behind a transaction-mode PgBouncer
POSTGRES_SKIP_DEFAULT_TRANSACTION=false

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DEFAULT_TTL=10m               # applies to every Set with a zero override
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_MAX_RETRIES=3

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=app
MONGO_CONNECT_TIMEOUT=10s
MONGO_QUERY_TIMEOUT=10s
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_CONN_IDLE_TIME=5m

# ─── Cassandra ────────────────────────────────────────────────────────────────
CASSANDRA_HOSTS=localhost:9042      # comma-separated
CASSANDRA_KEYSPACE=app
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_CONSISTENCY=QUORUM        # ANY|ONE|TWO|THREE|QUORUM|ALL|LOCAL_QUORUM|EACH_QUORUM|LOCAL_ONE
CASSANDRA_TIMEOUT=10s
CASSANDRA_CONNECT_TIMEOUT=10s
CASSANDRA_NUM_CONNS=2
CASSANDRA_PAGE_SIZE=500
CASSANDRA_ALLOW_FILTERING=false     # leave off: it turns queries into cluster scans

# ─── DynamoDB ─────────────────────────────────────────────────────────────────
DYNAMODB_REGION=ap-southeast-1
DYNAMODB_ENDPOINT=http://localhost:8000   # DynamoDB Local; empty for real AWS
DYNAMODB_ACCESS_KEY_ID=local              # leave empty in AWS to use the role chain
DYNAMODB_SECRET_ACCESS_KEY=local
DYNAMODB_SESSION_TOKEN=
DYNAMODB_TIMEOUT=10s
DYNAMODB_TABLE_PREFIX=

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_ADDRESSES=http://localhost:9200   # comma-separated
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CLOUD_ID=
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_TIMEOUT=10s
ELASTICSEARCH_DEFAULT_INDEX=

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092        # comma-separated
KAFKA_TOPIC=
KAFKA_GROUP_ID=                     # required to consume
KAFKA_BATCH_SIZE=100
KAFKA_BATCH_TIMEOUT=1s
KAFKA_WRITE_TIMEOUT=10s
KAFKA_READ_TIMEOUT=10s
KAFKA_DIAL_TIMEOUT=10s
KAFKA_MAX_ATTEMPTS=3
KAFKA_REQUIRED_ACKS=-1              # 0 none | 1 leader | -1 all in-sync replicas
KAFKA_ASYNC=false
KAFKA_COMPRESSION=                  # gzip | snappy | lz4 | zstd
KAFKA_MIN_BYTES=1
KAFKA_MAX_BYTES=10485760
KAFKA_MAX_WAIT=500ms
KAFKA_START_OFFSET=last             # first | last

# ─── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=default
TEMPORAL_IDENTITY=
TEMPORAL_CONNECT_TIMEOUT=10s
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=100
TEMPORAL_MAX_CONCURRENT_WORKFLOW_TASKS=100

# ─── Mailpit (dev mail catcher) ───────────────────────────────────────────────
MAILPIT_HOST=localhost
MAILPIT_PORT=1025                   # SMTP; the web UI is on 8025
MAILPIT_FROM=no-reply@localhost
MAILPIT_USERNAME=
MAILPIT_PASSWORD=
MAILPIT_USE_TLS=false
MAILPIT_USE_STARTTLS=false
MAILPIT_INSECURE_SKIP_VERIFY=false
MAILPIT_TIMEOUT=10s
